{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir -p:*)",
      "Bash(node -v)",
      "Bash(node .claude/scripts/pre-change-check.js:*)",
      "Bash(node .claude/scripts/verify-change.js:*)",
      "Bash(node .claude/scripts/repo-map.js:*)",
      "Bash(node .claude/scripts/final-review.js:*)",
      "Bash(npm -v)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:prod:*)",
      "Bash(npm run dev:*)",
      "Bash(pnpm -v)",
      "Bash(pnpm build:prod:*)",
      "Bash(pnpm dev:*)",
      "Bash(mvn -v)",
      "Bash(mvn clean package:*)",
      "Bash(java -version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git submodule status:*)",
      "Bash(git stash list)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "mcp__dbhub__execute_sql"
    ],
    "ask": [
      "Bash(npm uninstall:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pip install:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git branch -D:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(scp:*)",
      "Bash(ssh:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf D:/:*)",
      "Bash(rm -rf C:/:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/work-log.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/work-log.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
